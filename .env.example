# Static template only. Never commit real credentials.
# Select network in code or the CLI; each network uses its own HMAC key pair.
BINANCE_API_KEY_MAIN=
BINANCE_API_SECRET_MAIN=
BINANCE_API_KEY_TEST=
BINANCE_API_SECRET_TEST=

# Optional; defaults shown below. USD-M Futures is the default market.
BINANCE_MARKET=usdm
BINANCE_TIMEOUT_SECONDS=10
BINANCE_RECV_WINDOW_MS=5000
